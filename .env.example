# Create a bot with @BotFather and put its token here (never commit the real token).
BOT_TOKEN=

# Telegram numeric user IDs allowed to use /admin; comma-separated.
ADMIN_IDS=

# Channel required to use the bot. Add the bot as an administrator there.
REQUIRED_CHANNEL=@prostofrogi
REQUIRED_CHANNEL_URL=https://t.me/prostofrogi

# App-specific reward points. Override these values to match your rules.
REFERRAL_REWARD=5
MIN_WITHDRAWAL=100

# Local default. On Railway, mount a Volume at /data and set this to
# /data/bot.sqlite3 so the database survives redeploys.
DATABASE_PATH=data/bot.sqlite3
LOG_LEVEL=INFO
